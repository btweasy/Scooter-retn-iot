# Skopiuj do .env (plik .env nie trafia do repozytorium) i ustaw własne wartości.
POSTGRES_PASSWORD=zmien-mnie
MQTT_BACKEND_PASSWORD=zmien-mnie
MQTT_EMULATOR_PASSWORD=zmien-mnie
# Token operatora dla żądań zmieniających stan (wypożyczenia, telemetria HTTP, alerty).
# Pusty = autoryzacja wyłączona.
API_TOKEN=
